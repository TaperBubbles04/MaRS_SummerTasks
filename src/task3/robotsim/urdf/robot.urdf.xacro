<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

    <material name="blue"><color rgba="0 0 0.8 1"/></material>
    <material name="black"><color rgba="0 0 0 1"/></material>
    <material name="white"><color rgba="1 1 1 1"/></material>

    <xacro:property name="wheel_radius" value="0.085"/>
    <xacro:macro name="rectangle_inertia" params="m x y z">
        <inertial>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0.0" ixz="0.0" 
                     iyy="${(m/12) * (x*x + z*z)}" iyz="0.0" 
                     izz="${(m/12) * (x*x + y*y)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h">
        <inertial>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0" 
                     iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0" 
                     izz="${(m/2) * (r*r)}"/>
        </inertial>
    </xacro:macro>

    <link name="dummy"></link>

    <joint name="chassis_joint" type="fixed">
        <parent link="dummy"/>
        <child link="chassis"/>
        <origin xyz="0 0 0"/> 
    </joint>

    <link name="chassis">
        <visual>
            <geometry><box size="0.6 0.4 0.2"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><box size="0.6 0.4 0.2"/></geometry>
        </collision>
        <xacro:rectangle_inertia m="5.0" x="0.6" y="0.4" z="0.2"/>
    </link>

    <xacro:macro name="wheel" params="name x_off y_off">
        <joint name="${name}_wheel_joint" type="continuous">
            <parent link="chassis"/>
            <child link="${name}_wheel"/>
            <origin xyz="${x_off} ${y_off} -0.085" rpy="-${pi/2} 0 0"/> 
            <axis xyz="0 0 1"/>
        </joint>

       <link name="${name}_wheel">
            <visual>
                <geometry><cylinder radius="${wheel_radius}" length="0.05"/></geometry>
                <material name="white"/>
            </visual>
            <collision>
                <geometry><cylinder radius="${wheel_radius}" length="0.05"/></geometry>
            </collision>
            <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="0.05"/>
        </link>
    </xacro:macro>

    <xacro:wheel name="front_left" x_off="0.2" y_off="0.225" />
    <xacro:wheel name="front_right" x_off="0.2" y_off="-0.225" />
    <xacro:wheel name="back_left" x_off="-0.2" y_off="0.225" />
    <xacro:wheel name="back_right" x_off="-0.2" y_off="-0.225" />

</robot>